{
  "name": "landing-keepsake-vite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run images",
    "build": "vite build",
    "prebuild": "npm run images",
    "postbuild": "node scripts/normalize-output.mjs",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "cd .. && husky lab-09/.husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.4.0",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.4.22",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "sass": "^1.77.8",
    "sharp": "^0.34.4",
    "stylelint": "^16.23.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  },
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md,yml}": [
      "prettier --write"
    ]
  }
}
